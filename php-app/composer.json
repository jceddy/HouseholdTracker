{
    "name": "householdtracker/php-app",
    "description": "PHP REST API for HouseholdTracker",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HouseholdTracker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HouseholdTracker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php"
    }
}
