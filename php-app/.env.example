DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=householdtracker
DB_USER=root
DB_PASSWORD=

# Public base URL the app is served at (no trailing slash), used to build
# links in emails, e.g. https://example.com/app if deployed under /app.
APP_URL=http://localhost:8000

# Optional: the site's own domain root (no trailing slash), used to build
# links back into the static frontend -- distinct from APP_URL when the
# PHP app is deployed under a path prefix like /app. If unset, derived
# from APP_URL by stripping a trailing '/app'.
SITE_URL=http://localhost:8000

# SMTP credentials used to send the email verification link at registration
# and the password reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=HouseholdTracker

# Lets a deploy apply pending database/migrations/*.sql via POST /migrate.
# See database/README.md.
MIGRATION_DEPLOY_KEY=

# Fireworks AI (https://fireworks.ai) API key used by POST /chat to run LLM
# requests -- see "LLM usage (Fireworks AI)" in php-app/README.md. Without
# this set, /chat returns 503.
FIREWORKS_API_KEY=
